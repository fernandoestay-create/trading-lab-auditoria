# Plantilla de variables. NO poner valores reales aqui: este archivo SI se
# versiona. Los valores van en .env, que esta en .gitignore con permisos 600.

# --- DEMO (en uso) ---
EXNESS_API_KEY_DEMO=
EXNESS_PRIVATE_KEY_DEMO_PATH=
EXNESS_ACCOUNT_ID_DEMO=

# --- REAL (NO usar sin autorizacion explicita de Fernando) ---
# El par de llaves de REAL es DISTINTO al de DEMO, a proposito: asi se
# puede revocar uno sin tocar el otro, y una equivocacion en demo no
# puede alcanzar la cuenta real.
# La privada vive en ~/.config/trading-lab/exness_real_private.pem (600).
EXNESS_API_KEY_REAL=
EXNESS_PRIVATE_KEY_REAL_PATH=
EXNESS_ACCOUNT_ID_REAL=

# Gateway del widget DNS. El punto de acceso de la cuenta NO se fija:
# se descubre con GET /v1/trading/access-point.
EXNESS_GATEWAY=

# El entorno por defecto es DEMO. Para REAL hacen falta DOS cosas:
#   TRADING_LAB_ENTORNO=REAL  y  TRADING_LAB_AUTORIZO_REAL=si
